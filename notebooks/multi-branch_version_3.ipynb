 make_synthetic_cmi_df(n_subjects=8, sequences_per_subject=4, n_timesteps=80, random_state=random_state)\n","    sensor_columns = [c for c in train_df.columns if c.startswith(('acc_', 'rot_', 'tof_', 'thm_'))]\n","    print(f'Using synthetic CMI dataset fallback: {train_df[\"sequence_id\"].nunique()} sequences')\n","\n","train_df['gesture'] = train_df['gesture'].fillna('non_bfrb').astype(str)\n","train_df['orientation'] = train_df.get('orientation', pd.Series('Seated Straight', index=train_df.index)).fillna('Unknown').astype(str)\n","if 'sequence_type' in train_df.columns:\n","    train_df['is_target'] = train_df['sequence_type'].eq('Target').astype(np.uint8)\n","else:\n","    train_df['is_target'] = train_df.get('is_target', pd.Series(1, index=train_df.index)).astype(np.uint8)\n","train_df['bfrb'] = train_df['gesture'].where(train_df['is_target'].eq(1), 'non_bfrb')\n","\n","gesture_parts = {gesture: gesture.split(' - ') for gesture in train_df['gesture'].unique()}\n","train_df['gesture_position'] = train_df['gesture'].map({gesture: parts[0] for gesture, parts in gesture_parts.items()})\n","train_df['gesture_action'] = train_df['gesture'].map({gesture: parts[-1] for gesture, parts in gesture_parts.items()})\n","\n","if TARGET_COL not in {'bfrb', 'gesture_action', 'orientation', 'gesture', 'gesture_position'}:\n","    raise ValueError('Unsupported TARGET_COL.')\n","\n","keep_rows = pd.Series(True, index=train_df.index)\n","if orientation_filter_list:\n","    keep_rows &= train_df['orientation'].isin(orientation_filter_list)\n","if gesture_position_filter_list:\n","    keep_rows &= train_df['gesture_position'].isin(gesture_position_filter_list)\n","if gesture_filter_list:\n","    keep_rows &= train_df['gesture'].isin(gesture_filter_list)\n","if target_only_bool:\n","    keep_rows &= train_df['is_target'].eq(1)\n","if not keep_rows.all():\n","    train_df = train_df.loc[keep_rows].copy()\n","del keep_rows, gesture_parts\n","\n","quaternion_cols = ['rot_w', 'rot_x', 'rot_y', 'rot_z']\n","quaternions = train_df[quaternion_cols].to_numpy(dtype=np.float64)\n","valid_quaternion = np.isfinite(quaternions).all(axis=1) & (np.linalg.norm(quaternions, axis=1) > 0)\n","orientation_available = pd.Series(valid_quaternion, index=train_df.index).groupby(train_df['sequence_id']).any()\n","excluded_orientation_ids = orientation_available.index[~orientation_available].tolist()\n","if excluded_orientation_ids:\n","    print(f'Excluding {len(excluded_orientation_ids)} sequences with no valid orientation before splitting.')\n","    train_df = train_df[~train_df['sequence_id'].isin(excluded_orientation_ids)].copy()\n","\n","del quaternions, valid_quaternion, orientation_available\n","\n","train_df[TARGET_COL] = train_df[TARGET_COL].fillna('non_bfrb').astype(str)\n","print(f'Target: {TARGET_COL}; sequences after filters: {train_df[\"sequence_id\"].nunique()}')\n"]},{"cell_type":"code","execution_count":null,"id":"e6eb4383","metadata":{"papermill":{"duration":0.003617,"end_time":"2026-11-10T00:14:34.76592+00:00","exception":false,"start_time":"2026-11-10T00:14:34.762303+00:00","status":"completed"},"tags":[]},"outputs":[],"source":[]},{"cell_type":"code","execution_count":5,"id":"11a20dca","metadata":{"execution":{"iopub.execute_input":"2026-11-10T00:14:34.777829Z","iopub.status.busy":"2026-11-10T00:14:34.777452Z","iopub.status.idle":"2026-11-10T00:14:34.81057Z","shell.execute_reply":"2026-11-10T00:14:34.80943Z"},"papermill":{"duration":0.043275,"end_time":"2026-11-10T00:14:34.812499+00:00","exception":false,"start_time":"2026-11-10T00:14:34.769224+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Available sequences: 8101\n"]}],"source":["# Keep complete sequences available; each selected validation protocol splits them\n","# before extraction and scaling. Sequence splitting remains the default.\n","experiment_df = train_df\n","del train_df\n","print('Available sequences:', experiment_df['sequence_id'].nunique())\n"]},{"cell_type":"code","execution_count":null,"id":"d3209218","metadata":{"papermill":{"duration":0.003423,"end_time":"2026-11-10T00:14:34.819936+00:00","exception":false,"start_time":"2026-11-10T00:14:34.816513+00:00","status":"completed"},"tags":[]},"outputs":[],"source":[]},{"cell_type":"code","execution_count":6,"id":"ba73ece7","metadata":{"execution":{"iopub.execute_input":"2026-11-10T00:14:34.828518Z","iopub.status.busy":"2026-11-10T00:14:34.82817Z","iopub.status.idle":"2026-11-10T00:14:34.834027Z","shell.execute_reply":"2026-11-10T00:14:34.833377Z"},"papermill":{"duration":0.011967,"end_time":"2026-11-10T00:14:34.835556+00:00","exception":false,"start_time":"2026-11-10T00:14:34.823589+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["extractor = MultiModalSequenceExtractor(\n","    noop=NoopOptions(),\n","    imu_native_sampling_rate=100.0,\n","    rot_native_sampling_rate=100.0,\n","    thm_native_sampling_rate=20.0,\n","    tof_native_sampling_rate=20.0,\n",")\n","\n","clf = MultiBranchTSAIClassifier(\n","    extractor=extractor,\n","    augmentor=TSAugmentor(prob=0.0, per_aug_prob=0.0, random_state=random_state),\n","    primary_target=TARGET_COL,\n","    arch='Conv1d',\n","    dropout=0.0,\n","    branch_dropout=0.0,\n","    conv_dropout=0.0,\n","    static_dropout=0.0,\n","    fusion_dropout=0.0,\n","    weight_decay=0.0,\n","    label_smoothing=0.0,\n","    invalid_candidate_policy=INVALID_CANDIDATE_POLICY,\n","    candidate_failure_log=str(results_dir / f'{timestamp}_candidate_failures.jsonl'),\n","    verbose=epoch_verbosity,\n","    random_state=random_state,\n",")\n","pipeline = Pipeline([('estimator', clf)])\n"]},{"cell_type":"code","execution_count":null,"id":"1560c391","metadata":{"papermill":{"duration":0.003727,"end_time":"2026-11-10T00:14:34.843004+00:00","exception":false,"start_time":"2026-11-10T00:14:34.839277+00:00","status":"completed"},"tags":[]},"outputs":[],"source":[]},{"cell_type":"markdown","id":"503106b4","metadata":{"papermill":{"duration":0.003654,"end_time":"2026-11-10T00:14:34.850527+00:00","exception":false,"start_time":"2026-11-10T00:14:34.846873+00:00","status":"completed"},"tags":[]},"source":["# Params\n","\n","Search spaces are organised into three separate, self-contained cells (`GRID_PARAM_SPACE`, `BAYESIAN_PARAM_SPACE`, and `EVOLUTIONARY_PARAM_SPACE`) with zero `.update()` calls:\n","\n","1. **Clean Starting Combination for Bayesian Search**: Iteration 0 deterministically starts with augmentations switched off (`prob=0.0`, `per_aug_prob=0.0`), minimal regularization (`weight_decay=0.0`, `label_smoothing=0.0`), and all dropouts set to `0.0` (`dropout=0.0`, `branch_dropout=0.0`, `conv_dropout=0.0`, `static_dropout=0.0`, `fusion_dropout=0.0`).\n","2. **Feature Extractions (3 Options Each)**: Every feature-extraction mode (`acc_modes`, `rotation_modes`, `thm_modes`, `tof_modes`, `static_backend`, `static_channels`, `tsfel_domains`, and `noop__motion_stats`, `noop__periodicity`, `noop__spectral_stats`, `noop__power_branches`, `noop__signal`, `noop__quality`) exposes 3 options.\n","3. **One Simplest Architecture + Small Size Range**: Fixes `estimator__arch` to `'Conv1d'` and explores a compact range of sizes (`branch_filters`: `[64, 96, 128]`, `branch_depth`: `[2, 3]`, `branch_units`: `[64, 96, 128]`, `fusion_units`: `[64, 96, 128]`, `dense_units`: `[64, 96, 128]`).\n","4. **Minimal Regularization Exploration (2 Options)**: Dropouts explore `[0.0, 0.1]`, weight decay explores `[0.0, 1e-5]`, and label smoothing explores `[0.0, 0.05]`.\n"]},{"cell_type":"markdown","id":"9759f075","metadata":{"papermill":{"duration":0.003414,"end_time":"2026-11-10T00:14:34.857575+00:00","exception":false,"start_time":"2026-11-10T00:14:34.854161+00:00","status":"completed"},"tags":[]},"source":["## Grid"]},{"cell_type":"code","execution_count":7,"id":"a259fcfe","metadata":{"execution":{"iopub.execute_input":"2026-11-10T00:14:34.866573Z","iopub.status.busy":"2026-11-10T00:14:34.86