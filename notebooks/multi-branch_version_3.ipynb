   "source": [
    "# Trained-model permutation importance\n",
    "\n",
    "The score is the decrease in sequence macro-F1 after exchanging whole recording inputs between compatible internal-validation sequences. Motion inputs and their derived representations move together in the coherent motion group; each NOOP feature (including `cr7_kimmitch` features) is additionally permuted in its own column. Donors share the same chunk count and padding layout.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "v3_importance_code",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Never substitute X_test/y_test here: final holdout is not an importance dataset.\n",
    "NOOP_IMPORTANCE_REPEATS = 3\n",
    "noop_importance = None\n",
    "if experiment_succeeded:\n",
    "    best_model = search.best_estimator_\n",
    "    fitted_estimator = best_model.named_steps['estimator']\n",
    "    internal_ids = pd.Index(getattr(fitted_estimator, 'validation_sequence_ids_', []))\n",
    "    sequence_col = getattr(fitted_estimator.extractor_, 'sequence_col', 'sequence_id')\n",
    "    if internal_ids.empty:\n",
    "        print('Permutation importance skipped: fitted model has no internal validation partition.')\n",
    "    else:\n",
    "        raw_internal = X_train.loc[X_train[sequence_col].isin(internal_ids)]\n",
    "        X_internal = fitted_estimator.extractor_.select_finetuning_sequences(raw_internal, y_train)\n",
    "        y_internal = y_train.loc[X_internal.index]\n",
    "        noop_importance = compute_permutation_importance(\n",
    "            best_model, X_internal, y_internal,\n",
    "            repeats=NOOP_IMPORTANCE_REPEATS, random_state=random_state,\n",
    "            include_noop_individual=True, require_internal_validation=True,\n",
    "            output_dir=results_dir / timestamp,\n",
    "            prefix=f'{experiment_name}_internal_permutation',\n",
    "        )\n",
    "        print('Importance scope:', noop_importance.attrs['scope'])\n",
    "        print('Internal baseline macro-F1:', noop_importance.attrs['baseline_macro_f1'])\n",
    "        print('Permutable sequence fraction:', noop_importance.attrs['permutable_fraction'])\n",
    "        from IPython.display import Image, display\n",
    "        display(noop_importance[['kind', 'name', 'importance_mean', 'importance_std',\n",
    "                                 'n_sequences', 'n_permutable_sequences']])\n",
    "        display(Image(filename=noop_importance.attrs['paths']['plot']))\n",
    "        print('Importance files:', noop_importance.attrs['paths'])\n"
   ]
