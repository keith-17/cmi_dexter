    "    search = GridSearchCV(\n",
    "        estimator=pipeline,\n",
    "        param_grid=best_grid,\n",
    "        scoring=candidate_score,\n",
    "        cv=cv_object,\n",
    "        refit=refit_valid_candidate,\n",
    "        verbose=verbose,\n",
    "        error_score=error_score,\n",
    "        n_jobs=n_jobs,\n",
    "    )\n",
    "elif search_mode == 'bayes':\n",
    "    if not SKOPT_AVAILABLE:\n",
    "        raise ImportError('scikit-optimize is required for Bayesian search')\n",
    "    search = HierarchicalBayesSearchCV(\n",
    "        estimator=pipeline,\n",
    "        search_spaces=param_space,\n",
    "        n_iter=n_iter,\n",
    "        scoring=candidate_score,\n",
    "        cv=cv_object,\n",
    "        refit=refit_valid_candidate,\n",
    "        random_state=random_state,\n",
    "        verbose=verbose,\n",
    "        error_score=error_score,\n",
    "        n_jobs=n_jobs,\n",
    "    )\n",
    "elif search_mode == 'evo':\n",
    "    search = HierarchicalGASearchCV(\n",
    "        estimator=pipeline,\n",
    "        param_grid=param_space,\n",
    "        scoring=candidate_score,\n",
    "        cv=cv_object,\n",
    "        refit=refit_valid_candidate,\n",
    "        population_size=population_size,\n",
    "        generations=generations,\n",
    "        tournament_size=tournament_size,\n",
    "        elitism=elitism,\n",
    "        crossover_probability=crossover_probability,\n",
    "        mutation_probability=mutation_probability,\n",
    "        random_state=random_state,\n",
    "        verbose=verbose,\n",
    "        error_score=error_score,\n",
    "        n_jobs=n_jobs,\n",
    "    )\n",
    "else:\n",
    "    deduped_grid = deduplicate_param_grid(param_space, base_params=pipeline.get_params(deep=True))\n",
    "    search = GridSearchCV(\n",
    "        estimator=pipeline,\n",
    "        param_grid=deduped_grid,\n",
    "        scoring=candidate_score,\n",
    "        cv=cv_object,\n",
    "        refit=refit_valid_candidate,\n",
    "        verbose=verbose,\n",
    "        error_score=error_score,\n",
    "        n_jobs=n_jobs,\n",
    "    )\n",
