    "cv_test_size = 0.4\n",
    "train_size = 0.6\n",
    "n_iter = 15\n",
    "verbose = 4\n",
    "error_score = 'raise'\n",
    "n_jobs = 1                 # TensorFlow models should not be fitted in parallel\n",
